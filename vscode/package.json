{
  "name": "billable",
  "displayName": "Billable: Claude Code accounts and cost per client",
  "description": "Formerly Claude Multi-Account. Run each project on its own Claude account. See the account, tokens, cost and limits in the status bar, switch with one click, and stop idle Claude sessions that hold RAM.",
  "publisher": "roychemo",
  "version": "0.6.1",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/roych28/claude-multi-account"
  },
  "bugs": {
    "url": "https://github.com/roych28/claude-multi-account/issues"
  },
  "homepage": "https://github.com/roych28/claude-multi-account#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "multiple accounts",
    "freelance",
    "tokens",
    "usage",
    "cost",
    "invoice",
    "billing",
    "sessions",
    "idle",
    "memory"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test test/lib.test.js test/report.test.js",
    "test:integration": "node test/integration/run.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeMultiAccount.switch",
        "title": "Switch account for this folder",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.addAccount",
        "title": "Add account",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.costReport",
        "title": "Cost report by account",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.stopIdleSessions",
        "title": "Stop idle sessions",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.setupLauncher",
        "title": "Start Claude Code tabs on the folder's account",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.refresh",
        "title": "Refresh",
        "category": "Billable"
      },
      {
        "command": "claudeMultiAccount.enterLicense",
        "title": "Enter Pro license key",
        "category": "Billable"
      }
    ],
    "configuration": {
      "title": "Billable",
      "properties": {
        "claudeMultiAccount.idleSessions.autoStopHours": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Stop Claude Code sessions that have been idle longer than this many hours, checked every 30 minutes. `0` turns it off; any other value counts as at least 1 hour. A session is stopped only when Claude Code marks it idle, its transcript has not changed for that long, and its process uses almost no CPU. The conversation stays on disk, and a notification gives the command to resume it."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/roych28"
  }
}
