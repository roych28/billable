#!/bin/sh
# cma dir [path]     print the Claude config dir the folder runs on (nothing when no rule matches)
# cma exec cmd ...   run cmd with CLAUDE_CONFIG_DIR set for the current folder
# The files may carry a BOM, CRLF line endings and spaces around the fields; a name listed twice keeps its first line.
BASE="${CLAUDE_MULTI_ACCOUNT_HOME:-$HOME/.claude-multi-account}"

resolve() {
  [ -f "$BASE/accounts" ] && [ -f "$BASE/folders" ] || return 0
  awk -F'\t' -v dir="$1" -v home="$HOME" '
    function expand(p) {
      if (p == "~") p = home
      else if (substr(p, 1, 2) == "~/") p = home substr(p, 2)
      sub(/\/+$/, "", p)
      return p
    }
    FNR == 1 && substr($0, 1, 3) == "\357\273\277" { $0 = substr($0, 4) }
    { sub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, "", $1); gsub(/^[ \t]+|[ \t]+$/, "", $2) }
    /^[ \t]*#/ || NF < 2 || $1 == "" || $2 == "" { next }
    FILENAME == ARGV[1] { if (!($1 in acc)) acc[$1] = expand($2); next }
    {
      if ($1 == "*") { if (best == "") { best = "*"; name = $2 }; next }
      p = expand($1)
      if (dir == p || index(dir, p "/") == 1)
        if (best == "" || best == "*" || length(p) > length(best)) { best = p; name = $2 }
    }
    END { if (name in acc) print acc[name] }
  ' "$BASE/accounts" "$BASE/folders"
}

case "$1" in
  dir)
    resolve "${2:-$PWD}"
    ;;
  exec)
    shift
    d=$(resolve "$PWD")
    [ -n "$d" ] || d=$(resolve "$(pwd -P)")
    if [ "$d" = "$HOME/.claude" ]; then
      unset CLAUDE_CONFIG_DIR
    elif [ -n "$d" ]; then
      CLAUDE_CONFIG_DIR="$d"
      export CLAUDE_CONFIG_DIR
    fi
    exec "$@"
    ;;
  *)
    echo "usage: cma dir [path] | cma exec command [args...]" >&2
    exit 2
    ;;
esac
